---
import Panel from "./Panel.astro";

const {
    leftTitle,
    rightTitle,
    leftContent,
    rightContent,
    leftHidden = false,
    rightHidden = false,
} = Astro.props as {
    leftTitle: string;
    rightTitle: string;
    leftContent: string;
    rightContent: string;
    leftHidden?: boolean;
    rightHidden?: boolean;
};
---

<section class="not-prose my-6">
    <div class="grid gap-4 md:grid-cols-2">
        <Panel title={leftTitle} content={leftContent} hidden={leftHidden} />
        <Panel title={rightTitle} content={rightContent} hidden={rightHidden} />
    </div>
</section>

<style>
    [x-cloak] {
        display: none !important;
    }
</style>
