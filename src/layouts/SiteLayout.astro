---
import "../styles/global.css";
import Header from "../components/Header.astro";

const { title = "Python -> Excel" } = Astro.props;
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{title}</title>
		<script
			defer
			src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
		></script>
	</head>
	<body class="bg-zinc-50 text-zinc-900 antialiased">
		<Header />
		<main class="mx-auto max-w-7xl px-4 py-10">
			<article class="prose prose-zinc max-w-none">
				<slot />
			</article>
		</main>
		<footer class="border-t border-zinc-200">
			<div class="mx-auto max-w-7xl px-4 py-8 text-sm text-zinc-500">
				© {new Date().getFullYear()} — Built with Astro & Tailwind
			</div>
		</footer>
	</body>
</html>
